# Copy to /etc/mtandao-gateway/gateway.env (owner root, mode 0640, group mtandao-gateway).
# This file holds no secret: tokens and passwords live in separate 0600 files.

CLOUD_API_URL=https://api.example.invalid
GATEWAY_TOKEN_FILE=/etc/mtandao-gateway/gateway.token
ROUTEROS_CONFIG_FILE=/etc/mtandao-gateway/router.json

# Cloud command execution is OFF unless explicitly enabled: it lets the Cloud
# create and disable Hotspot vouchers on the router.
GATEWAY_COMMANDS_ENABLED=false
# GATEWAY_COMMAND_POLL_INTERVAL=10
# Optional pinning: refuse commands addressed to any other site or router.
# GATEWAY_SITE_ID=
# GATEWAY_ROUTER_ID=
